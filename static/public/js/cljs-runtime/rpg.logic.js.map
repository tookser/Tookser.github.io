(ns rpg.logic
  (:require [rpg.state :as state]
            [rpg.text :as text]))

(def player-damage 3)

(def last-enemy-id 2)

;; milliseconds per tick

;
;(defn stop-ticker [s]
;  (update-in s
;             [:ticker]
;             js/clearInterval))


(defn add-log [s entry]
  (let [previous-log (get-in s [:log])]
    (assoc-in s [:log] (cons entry previous-log))))

(defn player-alive? [s]
  (let [player-hp (get-in s [:player :hp])]
    (< 0 player-hp)))

(defn enemy-alive? [s]
  (let [enemy-hp (get-in s [:enemy :hp])]
    (< 0 enemy-hp)))

(defn enemy-last? [s]
  (= last-enemy-id (get-in s [:enemy :id])))


(defn player-is-block? [s]
  (not= (get-in s [:player :block]) 0))

(defn enemy-is-block? [s]
  (not= (get-in s [:enemy :block]) 0))


(defn is-game-over? [s]
  (not= (get-in s [:status]) :playing))

(defn check-game-over [s]
  (cond
    (not (player-alive? s))         (-> s
                                        (assoc-in [:status] :lost))
    (and
     (not (enemy-alive? s))
     (enemy-last? s))          (-> s
                                   (assoc-in [:status] :won))
    :else                           (assoc s :status :playing)))


(defn make-turn [s turn & args]
  ;; turn - player-attack player-heal enemy-attack
  (cond
    (not (is-game-over? s)) (check-game-over (apply turn s args))
    :else                   s))

(defn player-attack [s]
  (let [enemy-hp          (get-in s [:enemy :hp])
        new-hp            (max 0 (- enemy-hp player-damage))
        diff-enemy-hp     (- new-hp enemy-hp)
        player-atb        (get-in s [:player :atb])
        player-atb-max    (get-in s [:player :atb-max])]
    (if (= player-atb player-atb-max)
      (if-not (enemy-is-block? s)
        (-> s
            (assoc-in [:enemy :hp] new-hp)
            (assoc-in [:player :atb] 0)
            (add-log (text/player-attack-message-generate diff-enemy-hp))
            (check-game-over))
        (-> s
            (assoc-in [:player :atb] 0)
            (add-log (text/player-attack-block))
            (check-game-over)))
      (-> s
          (update-in [:player :hp] dec)
          (add-log (text/player-attack-false-attack -1))
          (check-game-over)))))


(defn player-heal [s]
  (let [number-of-potions     (get-in s [:player :healing-potions])
        new-number-of-potions (- number-of-potions 1)
        player-hp             (get-in s [:player :hp])
        max-player-hp         (get-in s [:player :max-hp])
        new-player-hp         (min (+ 5 player-hp) max-player-hp)
        diff-player-hp        (- new-player-hp player-hp)]
    (cond (< 0 number-of-potions)     (-> s
                                          (assoc-in [:player :healing-potions] new-number-of-potions)
                                          (assoc-in [:player :hp] new-player-hp)
                                          (add-log (text/player-heal-message-generate diff-player-hp))
                                          (check-game-over))
      :else                           s)))

(defn player-block [s]
  (let [player-atb         (get-in s [:player :atb])
        player-atb-max     (get-in s [:player :atb-max])
        player-block-max   (get-in s [:player :block-max])]
    (if (= player-atb player-atb-max)
      (-> s
          (assoc-in [:player :block] player-block-max)
          (assoc-in [:player :atb] 0)
          (add-log (text/player-block-set))
          (check-game-over))
      s)))

(defn enemy-attack [s]
  (let [player-hp      (get-in s [:player :hp])
        enemy-damage   (get-in s [:enemy :damage])
        new-hp         (max 0 (- player-hp enemy-damage))
        diff-player-hp (- new-hp player-hp)]
    (if-not (player-is-block? s)
      (-> s
          (assoc-in [:player :hp] new-hp)
          (assoc-in [:enemy :atb] 0)
          (add-log (text/enemy-attack-message-generate diff-player-hp))
          (check-game-over))
      (-> s
          (assoc-in [:enemy :atb] 0)
          (add-log (text/enemy-attack-block))
          (check-game-over)))))

(defn update-enemy [s]
  (if (and (not (enemy-alive? s)) (not (enemy-last? s)))
    (assoc-in s [:enemy]
              (case (get-in s [:enemy :id])
                0 state/bear
                1 state/butterfly))
    s))

;
;;(defn player-heal? [s]
;;  (let [number-of-potions (get-in s [:player :healing-potions])]
;;    (< 0 number-of-potions)))

(defn tick [s]
  (if-not (is-game-over? s)
    (-> s
        (update-in [:ticks] inc)
        (update-enemy)
        (#(if (= (get-in % [:enemy :atb-max])
                 (get-in % [:enemy :atb]))
           (enemy-attack %)
           %))
        (update-in [:player :atb] ; player atb refill
                   #(min (get-in s [:player :atb-max])
                     (+ (get-in s [:player :atb-speed])
                        %)))
        (update-in [:enemy :atb] ; enemy atb refill
                   #(min (get-in s [:enemy :atb-max])
                     (+ (get-in s [:enemy :atb-speed])
                        %)))
        (update-in [:player :block] ; player block spent
                   #(max
                     0
                     (dec (get-in s [:player :block])))))
    s))