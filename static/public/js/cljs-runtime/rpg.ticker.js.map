(ns rpg.ticker
  (:require
    [rpg.logic :as logic]
    [rpg.state :as state]))

(def tick-milliseconds 5)

(def initial-ticker
  {:ticker nil})

(defonce ticker (atom initial-ticker))


(defn start-ticker []
  (when-let [ticker-id (:ticker @ticker)]
    (js/clearInterval ticker-id))
  (swap! ticker
         assoc-in [:ticker]
         (js/setInterval
          #(swap! state/app-state logic/tick) tick-milliseconds)))

(defn stop-ticker []
  (when-let [ticker-id (:ticker @ticker)]
    (js/clearInterval ticker-id)
    (swap! ticker
           assoc-in [:ticker] nil)))

(defn restart-game []
  (reset! state/app-state state/initial-state)
  (start-ticker))
