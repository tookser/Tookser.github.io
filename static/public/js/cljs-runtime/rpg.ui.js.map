(ns rpg.ui
  (:require
    [reagent.core :as r]
    [rpg.state :as state]
    [rpg.logic :as logic]
    [rpg.ticker :as ticker]))

(ticker/restart-game)

(defn enemy-name [s]
  [:i [:p (str (get-in s [:enemy :name]) ":")]])

(defn log-view [log]
  [:div.log
   [:h3 "Log"]

   (for [[idx [creature entry]] (map-indexed vector log)]
     [:div.log-entry
      {:key idx}
      entry])])

(defn end-screen [s on-restart]
  [:div
   [:h2
    (case (:status s)
      :won  "🎉 Victory!"
      :lost "😭 You lose..."
      "")]
   [:button {:on-click on-restart}
    "Back to fight! (play again)"]])

(defn block-bar [{:keys [block block-max]}]
  (let [pct (* 100 (/ block block-max))]
    [:div.block-container
     [:div.block-fill {:style {:width (str pct "%")}}]]))

(defn atb-bar [{:keys [atb atb-max]}]
  (let [pct (* 100 (/ atb atb-max))]
    [:div.atb-container
     [:div.atb-fill {:style {:width (str pct "%")}}]]))

(defn hp-bar [{:keys [hp max-hp]}]
  (let [pct (* 100 (/ hp max-hp))]
    [:div.hp-container
     [:div.hp-fill {:style {:width (str pct "%")}}]]))

(defn root []
  (let [s @state/app-state]
    (case (:status s)
      :playing
      [:div.play-screen
       [:div.left-part
        {:style {}}

        [:h1 "Arena"]
        [:i [:p "Player:"]]
        [atb-bar (:player s)]
        ;        [:p "HP: " (get-in s [:player :hp])]
        [hp-bar (:player s)]
        [block-bar (:player s)]
        [:p "Healing Potions: " (get-in s [:player :healing-potions])]
        [enemy-name s]
;        [:p "Enemy:"]
        [atb-bar (:enemy s)]
        ;        [:p "HP: " (get-in s [:enemy :hp])]
        [hp-bar (:enemy s)]
        [:p "Status: " (name (:status s))]

        ;; attack
        [:button
         {:on-click #(swap! state/app-state
                      (fn [st]
                        (-> st
                            (logic/make-turn logic/player-attack))))}
         ;;(logic/make-turn logic/enemy-attack)
         "Attack"]

        ;; Heal
        [:button
         {:on-click #(swap! state/app-state
                      (fn [st]
                        (-> st
                            (logic/make-turn logic/player-heal))))}
         "Heal"]

        ;; Block
        [:button
         {:on-click #(swap! state/app-state
                      (fn [st]
                        (-> st
                            (logic/make-turn logic/player-block))))}
         "Block🛡️"]]
       ;; Log
       [log-view (:log s)]]
      (:won :lost)
      [:div.play-screen
       [:div
        {:style {:font-family "Roboto" :padding "20px"}}
        [end-screen
         s
         ticker/restart-game]]])))
