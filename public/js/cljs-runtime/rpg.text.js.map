(ns rpg.text)

(defn now-time-str []
  (let [d (js/Date.)]
    (str
     (.padStart (str (.getHours d)) 2 "0") ":"
     (.padStart (str (.getMinutes d)) 2 "0") ":"
     (.padStart (str (.getSeconds d)) 2 "0"))))

(defn player-heal-message-generate [hp]
  [:player (str (now-time-str) " Player heals... +" hp)])

(defn player-attack-message-generate [hp]
  [:player (str (now-time-str) " Player attacks enemy, " hp)])

(defn enemy-attack-message-generate [hp]
  [:enemy (str (now-time-str) " Enemy attacks player, " hp)])

(defn enemy-defeated []
  [:player (str (now-time-str) " Enemy was defeated!")])

(defn player-defeated []
  [:player (str (now-time-str) " Player was defeated! It is the end...")])

(defn player-attack-false-attack [hp]
  [:player (str (now-time-str) " False start! Player hurts himself... " hp)])

(defn player-block-set []
  [:player (str (now-time-str) " Player set block! 🛡️")])

(defn enemy-attack-block []
  [:enemy (str (now-time-str) " Enemy attack in block! ⚔️🛡️")])

(defn player-attack-block []
  [:player (str (now-time-str) " Player attack in block! ⚔️🛡️")])